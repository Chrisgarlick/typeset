#!/usr/bin/env bash
# Gets a fresh clone ready for local development: checks Rust and Typst,
# makes .env from .env.example (with a local DATABASE_URL) if there isn't one,
# creates the local typeset database if Postgres is running, fetches the crates
# and installs the frontend's packages. Safe to run again. Deploying is
# ./deploy.sh, never this.
set -euo pipefail
cd "$(dirname "$0")/.."

need() { command -v "$1" >/dev/null 2>&1 || { echo "bin/setup: $1 isn't installed. $2" >&2; exit 1; }; }
need cargo "Install Rust with rustup: https://rustup.rs"
need typst "brew install typst"
need node "Install Node.js (Herd's, or brew install node)"

# The snapshot tests only run when Typst matches the Dockerfile's.
want=$(sed -n 's/^ARG TYPST_VERSION=//p' Dockerfile)
have=$(typst --version | awk '{print $2}')
[ "$want" = "$have" ] || echo "note: typst is $have, the Dockerfile pins $want, so gallery_matches_snapshots will skip"

db_url="postgresql://postgres@127.0.0.1:5432/typeset"
if [ ! -f .env ]; then
  cp .env.example .env
  printf '\n# Local Postgres (DBngin)\nDATABASE_URL=%s\n' "$db_url" >> .env
  echo "made .env from .env.example: set CLIENTS_SERVICE_KEY to render with client brands"
fi

# The database migrations run against at start-up.
if command -v pg_isready >/dev/null 2>&1 && pg_isready -q -h 127.0.0.1 -p 5432; then
  if [ "$(psql -U postgres -h 127.0.0.1 -d postgres -tAc "select 1 from pg_database where datname = 'typeset'")" = 1 ]; then
    echo "database typeset already there"
  else
    createdb -U postgres -h 127.0.0.1 typeset && echo "created database typeset"
  fi
else
  echo "note: Postgres isn't running on 127.0.0.1:5432; start it (DBngin) and run bin/setup again to create the typeset database"
fi

cargo fetch

if command -v bun >/dev/null 2>&1; then
  (cd frontend && bun install --frozen-lockfile)
else
  need npm "It comes with Node.js"
  (cd frontend && npm install --no-package-lock --no-audit --no-fund)
fi

echo
echo "Ready. Run cargo run for the API on :3200, and npm run dev in frontend/ for the UI on :3000."
