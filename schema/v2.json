{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typeset.chrisgarlick.com/schema/v2.json",
  "title": "Typeset JSON document, schema 2",
  "description": "Schema 2 adds components. v1 blocks (heading, paragraph, markdown, bullet_list, ordered_list, table, code, blockquote, image (url, alt, caption, width: column | full), rule, page_break, columns, section) keep working and are described in API.md; they are accepted here without field checks. Component blocks reject unknown fields.",
  "type": "object",
  "required": [
    "schema",
    "pages"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "subtitle": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "recipient": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "author": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "date": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "eyebrow": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "reference": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "document_type": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "client": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "cover": {
          "enum": [
            "editorial",
            "band",
            "dark"
          ]
        }
      },
      "required": []
    },
    "pages": {
      "type": "array",
      "description": "Each page is a section boundary: a new page only when the current one is mostly used.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        },
        "required": []
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "detail": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "effort": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "title"
      ]
    },
    "v1_block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "markdown",
            "bullet_list",
            "ordered_list",
            "table",
            "code",
            "blockquote",
            "image",
            "rule",
            "page_break",
            "columns",
            "section"
          ]
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/v1_block"
        },
        {
          "$ref": "#/$defs/opener"
        },
        {
          "$ref": "#/$defs/callout"
        },
        {
          "$ref": "#/$defs/findings"
        },
        {
          "$ref": "#/$defs/steps"
        },
        {
          "$ref": "#/$defs/scores"
        },
        {
          "$ref": "#/$defs/metrics"
        },
        {
          "$ref": "#/$defs/facts"
        },
        {
          "$ref": "#/$defs/score_matrix"
        },
        {
          "$ref": "#/$defs/bars"
        },
        {
          "$ref": "#/$defs/severity_summary"
        },
        {
          "$ref": "#/$defs/finding"
        },
        {
          "$ref": "#/$defs/priority_matrix"
        },
        {
          "$ref": "#/$defs/contents"
        },
        {
          "$ref": "#/$defs/back_page"
        },
        {
          "$ref": "#/$defs/highlights"
        }
      ]
    },
    "opener": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "opener"
        },
        "title": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "eyebrow": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "intro": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "stat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            },
            "label": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            },
            "status": {
              "enum": [
                "good",
                "fair",
                "poor",
                "neutral"
              ]
            }
          },
          "required": [
            "value"
          ]
        }
      },
      "required": [
        "type",
        "title"
      ],
      "description": "Opens a numbered section: eyebrow, title, intro and an optional headline figure. Counts as an H2 section."
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "callout"
        },
        "tone": {
          "enum": [
            "info",
            "good",
            "warn",
            "critical",
            "brand"
          ],
          "default": "info"
        },
        "title": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "body": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "type",
        "body"
      ],
      "description": "A tinted note with a rule in its tone's colour."
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "findings"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "severity": {
                "enum": [
                  "critical",
                  "serious",
                  "moderate",
                  "minor"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "How many times it was found."
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Text; inline markdown (bold, italic, links, code) allowed."
                },
                "description": "Where: page names, or one entry such as \"All 5 pages\"."
              },
              "fix": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              }
            },
            "required": [
              "title",
              "severity"
            ]
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "description": "Issues as a table with severity badges."
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "steps"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            },
            "required": [
              "items"
            ]
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "A single untitled group."
        }
      },
      "required": [
        "type"
      ],
      "description": "Numbered steps, optionally grouped. Give groups or items."
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "scores"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "value": {
                "type": "number"
              },
              "max": {
                "type": "number",
                "default": 100
              },
              "benchmark": {
                "type": "number",
                "description": "A target, marked on the gauge."
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "caption": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "type",
        "items"
      ],
      "description": "A row of two to five score gauges."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "metrics"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "label": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "target": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "status": {
                "enum": [
                  "good",
                  "fair",
                  "poor",
                  "neutral"
                ]
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "description": "Headline figures, up to four per row."
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "facts"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "value": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "description": "Label and value pairs."
    },
    "score_matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "score_matrix"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "Text; inline markdown (bold, italic, links, code) allowed."
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "description": "One per column; null where there is no score."
              }
            },
            "required": [
              "label",
              "values"
            ]
          }
        },
        "max": {
          "type": "number",
          "default": 100
        },
        "caption": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "description": "Scores by page and category as a heat table."
    },
    "bars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bars"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "unit": {
          "type": "string",
          "description": "Appended to each value, e.g. \" s\"."
        },
        "target": {
          "type": "number"
        },
        "better": {
          "enum": [
            "lower",
            "higher"
          ],
          "default": "lower"
        },
        "caption": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "type",
        "items"
      ],
      "description": "Horizontal bars with a dashed target line, coloured by which side of the target they fall."
    },
    "severity_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "severity_summary"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "serious": {
              "type": "integer",
              "minimum": 0
            },
            "moderate": {
              "type": "integer",
              "minimum": 0
            },
            "minor": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": []
        },
        "caption": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "type",
        "counts"
      ],
      "description": "Issue counts by severity: a segmented bar over four counts."
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "finding"
        },
        "title": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "severity": {
          "enum": [
            "critical",
            "serious",
            "moderate",
            "minor"
          ]
        },
        "why": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "fix": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Text; inline markdown (bold, italic, links, code) allowed."
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            },
            "label": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            }
          },
          "required": [
            "value"
          ]
        }
      },
      "required": [
        "type",
        "title",
        "severity"
      ],
      "description": "One headline issue as a card."
    },
    "priority_matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "priority_matrix"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "impact": {
                "enum": [
                  "high",
                  "low"
                ]
              },
              "effort": {
                "enum": [
                  "high",
                  "low"
                ]
              }
            },
            "required": [
              "label",
              "impact",
              "effort"
            ]
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "description": "Impact against effort: quick wins, big bets, fill-ins, maybe later."
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "contents"
        },
        "title": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        }
      },
      "required": [
        "type"
      ],
      "description": "A contents list of the document's sections, on a page of its own."
    },
    "back_page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "back_page"
        },
        "about": {
          "type": "string",
          "description": "Text; inline markdown (bold, italic, links, code) allowed."
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            },
            "email": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            },
            "website": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            },
            "phone": {
              "type": "string",
              "description": "Text; inline markdown (bold, italic, links, code) allowed."
            }
          },
          "required": []
        }
      },
      "required": [
        "type"
      ],
      "description": "A closing page with the brand mark, an about line and contact details."
    },
    "highlights": {
      "type": "object",
      "additionalProperties": false,
      "description": "Up to four headline findings side by side, as compact cards.",
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "highlights"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "severity": {
                "enum": [
                  "critical",
                  "serious",
                  "moderate",
                  "minor"
                ]
              },
              "why": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "fix": {
                "type": "string",
                "description": "Text; inline markdown (bold, italic, links, code) allowed."
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Text; inline markdown (bold, italic, links, code) allowed."
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "string",
                    "description": "Text; inline markdown (bold, italic, links, code) allowed."
                  },
                  "label": {
                    "type": "string",
                    "description": "Text; inline markdown (bold, italic, links, code) allowed."
                  }
                },
                "required": [
                  "value"
                ]
              }
            },
            "required": [
              "title",
              "severity"
            ]
          }
        }
      }
    }
  }
}